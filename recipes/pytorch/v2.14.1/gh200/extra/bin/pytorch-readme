#!/bin/bash
# Show the readme of the pytorch uenv (generated by make-readme.py in the recipe).
# On a terminal: colour, paged with `less -R` (quits at once if it fits on the screen).
# Piped, redirected, or with NO_COLOR set: plain text.
README=/user-environment/readme
if [ ! -r "$README" ]; then
    echo "pytorch-readme: $README not found (is the pytorch uenv mounted?)" >&2
    exit 1
fi
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    if command -v less >/dev/null 2>&1; then
        exec less -RFX "$README"
    fi
    exec cat "$README"
fi
exec sed 's/\x1b\[[0-9;]*m//g' "$README"
