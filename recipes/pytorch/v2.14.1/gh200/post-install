#!/bin/bash
# pytorch uenv post-install hook (runs in the build sandbox; the image is mounted at /user-environment).
# Idempotent: it re-runs on every `make store.squashfs`.
set -euo pipefail
STORE=/user-environment
VIEW=$STORE/env/torch
# extra/ is copied by stackinator to meta/extra.
# readme: user readme (generated by make-readme.py), shown by the `pytorch-readme` command
install -m 0644 "$STORE/meta/extra/readme.txt" "$STORE/readme"
# user commands shipped in extra/bin, installed into the torch view:
#   pytorch-readme   shows /user-environment/readme
for f in "$STORE"/meta/extra/bin/*; do
    install -m 0755 "$f" "$VIEW/bin/$(basename "$f")"
done
