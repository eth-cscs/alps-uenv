 !-----------------------------------------------------------------------
 !
 !-----------------------------------------------------------------------
+subroutine set_diropn_recl (unit, recl)
+  !-----------------------------------------------------------------------
+  !! Stores the record length (in real(dp) words) of a unit opened by
+  !! diropn. An existing entry for the same unit is overwritten.
+  !
+  implicit none
+  integer, intent(in) :: unit, recl
+  integer, allocatable :: tmp(:)
+  integer :: i, n
+  !
+  if (.not. allocated(diropn_units)) then
+     allocate (diropn_units(0), diropn_recls(0))
+  end if
+  do i = 1, size(diropn_units)
+     if (diropn_units(i) == unit) then
+        diropn_recls(i) = recl
+        return
+     end if
+  end do
+  n = size(diropn_units)
+  allocate (tmp(n+1))
+  tmp(1:n) = diropn_units; tmp(n+1) = unit
+  call move_alloc (tmp, diropn_units)
+  allocate (tmp(n+1))
+  tmp(1:n) = diropn_recls; tmp(n+1) = recl
+  call move_alloc (tmp, diropn_recls)
+  !-----------------------------------------------------------------------
+end subroutine set_diropn_recl
+!-----------------------------------------------------------------------
+!
+!-----------------------------------------------------------------------
+integer function diropn_recl (unit)
+  !-----------------------------------------------------------------------
+  !! Record length (in real(dp) words) given to diropn when it last
+  !! opened this unit, or -1 if diropn never opened it.
+  !
+  implicit none
+  integer, intent(in) :: unit
+  integer :: i
+  !
+  diropn_recl = -1
+  if (.not. allocated(diropn_units)) return
+  do i = 1, size(diropn_units)
+     if (diropn_units(i) == unit) then
+        diropn_recl = diropn_recls(i)
+        return
+     end if
+  end do
+  !-----------------------------------------------------------------------
+end function diropn_recl
