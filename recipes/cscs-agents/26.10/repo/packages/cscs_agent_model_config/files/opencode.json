{
  "$schema": "https://opencode.ai/v2/config.json",
  "model": "cscs/moonshotai/Kimi-K2.7-Code",
  "agents": {
    "title": {"model": "cscs/moonshotai/Kimi-K2.7-Code"}
  },
  "permissions": [
    {"action": "external_directory", "resource": "*", "effect": "ask"}
  ],
  "providers": {
    "cscs": {
      "package": "@opencode/ai/providers/anthropic",
      "name": "CSCS Inference",
      "settings": {
        "baseURL": "https://api.inference.cscs.ch/v1",
        "systemMessageMode": "system",
        "apiKey": "{env:CSCS_INFERENCE_API_KEY}"
      },
      "models": {
        "google/gemma-4-31B-it": {
          "name": "Gemma 4 31B It [CSCS]",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "capabilities": {"tools": true, "input": ["text"], "output": ["text"]},
          "variants": []
        },
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi K2.7 Code [CSCS]",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "capabilities": {"tools": true, "input": ["text"], "output": ["text"]},
